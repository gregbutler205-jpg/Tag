# OpenAI — vision pipeline (OCR)
OPENAI_API_KEY=

# xAI Grok — plate interpretation engine
XAI_API_KEY=

# Supabase — database
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Auth
JWT_SECRET=change-before-production

# Google Cloud Vision (optional — fallback OCR)
GOOGLE_CLOUD_VISION_KEY=

# Server port (Render sets this automatically)
PORT=3001

# Vision pipeline settings
FIRST_PASS_MODEL=gpt-5.4-mini
ESCALATION_MODEL=gpt-5.4
INTERPRETATION_MODEL=grok-4-1-fast
CONFIDENCE_THRESHOLD=0.85
FIRST_PASS_DETAIL=high
ESCALATION_DETAIL=high
ESCALATION_REASONING_EFFORT=low
ESCALATION_USE_REASONING=false
